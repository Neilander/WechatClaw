LLM_API_KEY=your_deepseek_api_key
LLM_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

MAX_HISTORY_MESSAGES=20
SYSTEM_PROMPT=你是一个运行在微信里的 AI 助手，回答要简洁、有帮助。

# Optional: override the local memory file path.
# MEMORY_FILE=memory.json

# 企业微信客服配置（四个都填齐才会启用微信客服；本地开发可留空）
WECOM_CORP_ID=ww0b90e784acf31a36
WECOM_KF_SECRET=your_wecom_self_built_app_secret
WECOM_TOKEN=your_wecom_callback_token
WECOM_ENCODING_AES_KEY=your_wecom_callback_encoding_aes_key
# Optional: override the cursor file path.
# WECOM_CURSOR_FILE=wecom_cursor.json
